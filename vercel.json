{
  "functions": {
    "api/visual-check.js": {
      "maxDuration": 60
    },
    "api/cleanup.js": {
      "maxDuration": 60
    },
    "api/admin-users.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(submit|tickets|overview|guidelines|access)",
      "destination": "/index.html"
    },
    {
      "source": "/tickets/:ticket",
      "destination": "/index.html"
    }
  ]
}
